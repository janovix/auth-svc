{
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_als"],
	"main": "src/index.ts",
	"name": "auth-svc-prod",
	"upload_source_maps": true,
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},
	"observability": {
		"enabled": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "auth",
			"database_id": "da16c7b1-49d9-4644-a956-b671b1c2f09a",
		},
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "bdce8bcdb45b485fb0518fec19ab664b",
		},
	],
	"services": [
		{
			"binding": "AML_SERVICE",
			"service": "aml-svc-prod",
		},
		{
			"binding": "NOTIFICATIONS_SERVICE",
			"service": "notifications-svc-prod",
		},
	],
	"r2_buckets": [
		{
			"binding": "AVATARS_BUCKET",
			"bucket_name": "avatar",
		},
	],
	"vars": {
		"ENVIRONMENT": "production",
		"BETTER_AUTH_URL": "https://auth-svc.janovix.com",
		"AUTH_TRUSTED_ORIGINS": "https://*.janovix.com",
		"AUTH_FRONTEND_URL": "https://auth.janovix.com",
		"AVATARS_PUBLIC_URL": "https://avatar.janovix.com",
		// Note: Stripe price IDs are now managed in the database (plan_prices table)
		// API keys (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) must still be set via wrangler secrets
	},
}
