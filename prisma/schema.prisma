// Prisma schema for D1 database
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Better Auth User model
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  phone         String?
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Better Auth admin plugin fields
  role          String   @default("user")
  banned        Boolean  @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions Session[]
  accounts Account[]
  // Better Auth organization plugin relations
  memberships     Member[]
  invitationsSent Invitation[]

  @@map("users")
}

// Better Auth Session model
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  // Better Auth Organization plugin: current "active" org for the session.
  activeOrganizationId String?
  // Better Auth admin plugin: ID of admin user impersonating this session.
  impersonatedBy String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
}

// Better Auth Account model
model Account {
  id                     String   @id @default(uuid())
  accountId              String
  providerId             String
  userId                 String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
  @@index([userId])
}

// Better Auth Verification model
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
  @@index([identifier])
}

// Used by the Better Auth JWT plugin to persist key pairs for JWKS.
model Jwks {
  id        String   @id @default(uuid())
  publicKey String
  privateKey String
  createdAt DateTime @default(now())
  expiresAt DateTime?
  alg       String?
  crv       String?

  @@map("jwks")
  @@index([createdAt])
  @@index([expiresAt])
}

// Better Auth Organization model
model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logo        String?
  metadata    String?  // JSON string for organization settings (RFC, vulnerable activity, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     Member[]
  invitations Invitation[]

  @@map("organizations")
  @@index([slug])
}

// Better Auth Organization Member model
model Member {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String   @default("member") // owner, admin, member
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("members")
  @@index([organizationId])
  @@index([userId])
}

// Better Auth Organization Invitation model
model Invitation {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  role           String   @default("member")
  status         String   @default("pending") // pending, accepted, rejected, expired
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitations")
  @@index([organizationId])
  @@index([email])
  @@index([status])
}

// Organization-level default settings
model OrganizationSettings {
  id             String   @id @default(uuid())
  organizationId String   @unique
  theme          String   @default("system")      // light/dark/system
  timezone       String   @default("UTC")         // IANA timezone
  language       String   @default("en")          // ISO 639-1 code
  dateFormat     String   @default("MM/DD/YYYY")  @map("date_format")
  avatarUrl      String?  @map("avatar_url")
  metadata       String?                          // JSON for extensibility
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("organization_settings")
  @@index([organizationId])
}

// User-level settings (overrides org defaults when set)
model UserSettings {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  theme          String?                          // NULL = use org/browser default
  timezone       String?                          // NULL = use org/browser default
  language       String?                          // NULL = use org/browser default
  dateFormat     String?  @map("date_format")     // NULL = use org default
  avatarUrl      String?  @map("avatar_url")
  paymentMethods String?  @map("payment_methods") // JSON array of payment method refs
  metadata       String?                          // JSON for extensibility
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
  @@index([userId])
}

// Audit log entry with signature chain for integrity verification
model AuditLog {
  id                    String   @id @default(uuid())
  
  // Event identification
  eventType             String   @map("event_type")      // CREATE, UPDATE, DELETE, LOGIN, etc.
  entityType            String   @map("entity_type")     // user, organization, transaction, etc.
  entityId              String?  @map("entity_id")       // ID of affected entity
  
  // Actor information
  actorUserId           String?  @map("actor_user_id")
  actorOrganizationId   String?  @map("actor_organization_id")
  actorIp               String?  @map("actor_ip")
  actorUserAgent        String?  @map("actor_user_agent")
  
  // Change data (immutable snapshot)
  previousState         String?  @map("previous_state")  // JSON
  newState              String?  @map("new_state")       // JSON
  changeSummary         String?  @map("change_summary")  // JSON field-level diff
  
  // Context
  sourceService         String   @map("source_service")  // aml-svc, auth-svc, etc.
  requestId             String?  @map("request_id")      // Correlation ID
  metadata              String?                          // JSON additional context
  
  // Integrity chain
  signature             String                           // SHA-256 hash
  previousSignature     String?  @map("previous_signature")
  
  // Timestamps
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([actorOrganizationId])
  @@index([createdAt])
  @@index([eventType])
  @@index([sourceService])
  @@index([signature])
  @@index([previousSignature])
}
