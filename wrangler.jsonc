{
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_als"],
	"main": "src/index.ts",
	"name": "auth-svc",
	"upload_source_maps": true,
	"workers_dev": true,
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},
	"observability": {
		"enabled": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "auth-dev",
			"database_id": "80ca9ee0-571c-452d-a9ed-cffb4cc00975",
		},
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "a2247424da4c436a8f81f224116d0206",
		},
	],
	"services": [
		{
			"binding": "AML_SERVICE",
			"service": "aml-svc",
			"entrypoint": "AmlSvcEntrypoint",
		},
		{
			"binding": "NOTIFICATIONS_SERVICE",
			"service": "notifications-svc",
			"entrypoint": "NotificationsEntrypoint",
		},
	],
	"r2_buckets": [
		{
			"binding": "AVATARS_BUCKET",
			"bucket_name": "avatar",
		},
	],
	"vars": {
		"ENVIRONMENT": "dev",
		"BETTER_AUTH_URL": "https://auth-svc.janovix.workers.dev",
		"AUTH_TRUSTED_ORIGINS": "https://*.janovix.workers.dev,https://*.vusercontent.net",
		"AUTH_FRONTEND_URL": "https://auth.janovix.workers.dev",
		"AVATARS_PUBLIC_URL": "https://avatar.janovix.com",
	},
}
