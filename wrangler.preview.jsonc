{
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_als"],
	"main": "src/index.ts",
	"name": "backend-template",
	"upload_source_maps": true,
	"workers_dev": true,
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},
	"observability": {
		"enabled": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "auth-preview",
			"database_id": "0b60b3d0-6777-46bf-9896-6284defd0a6d",
		},
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "3c23d46024664e99b7a480bd052c9297",
		},
	],
	"services": [
		{
			"binding": "AML_SERVICE",
			"service": "aml-svc",
		},
	],
	"r2_buckets": [
		{
			"binding": "AVATARS_BUCKET",
			"bucket_name": "avatar",
		},
	],
	"vars": {
		"ENVIRONMENT": "preview",
		"BETTER_AUTH_URL": "https://auth-svc.janovix.workers.dev",
		"AUTH_TRUSTED_ORIGINS": "https://*.janovix.workers.dev",
		"AUTH_FRONTEND_URL": "https://auth.janovix.workers.dev",
		"AVATARS_PUBLIC_URL": "https://avatar.janovix.com",
		// Note: Stripe price IDs are stored in D1 database and seeded via 'pnpm seed:plans'
	},
}
